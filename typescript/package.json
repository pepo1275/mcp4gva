{
  "name": "mcp4gva-typescript",
  "version": "0.1.0",
  "description": "MCP server for GVA GIS ArcGIS API - TypeScript implementation",
  "type": "module",
  "bin": {
    "mcp4gva-ts": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "npm run build && node build/index.js"
  },
  "keywords": [
